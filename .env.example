# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# EA Companion App client secret for Madden 27 (from snallabot's ea_constants.ts)
EA_CLIENT_SECRET=

# Any random string of 32+ characters (e.g. from a password generator). Encrypts stored EA sessions. Must be the same in Vercel and in the GitHub Actions secret.
EA_TOKEN_KEY=

# Optional: start a league's first sync immediately instead of on the next 3-hourly run.
# Fine-grained GitHub token with Actions read/write on this repo.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=nickzcampanella-boop/cfm-manager
